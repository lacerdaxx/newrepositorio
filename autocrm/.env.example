# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Somente servidor — nunca expor no cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Domínio raiz usado para resolver subdomínios das lojas (loja.ROOT_DOMAIN)
NEXT_PUBLIC_ROOT_DOMAIN=meudominio.com.br
# Loja usada em desenvolvimento local (localhost não tem subdomínio)
NEXT_PUBLIC_DEV_TENANT_SLUG=abc-multimarcas

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# White-label da própria agência (domínio raiz / painel da agência)
NEXT_PUBLIC_AGENCY_NAME=AutoCRM
NEXT_PUBLIC_AGENCY_COLOR=#6366f1
