# URL do webhook que recebe os leads (CRM, Zapier, Make, n8n, RD Station, Kommo, Bitrix24, endpoint próprio...).
# Enquanto estiver vazio, o formulário NÃO simula envio: informa ao visitante que o canal não está ativo.
VITE_LEAD_WEBHOOK_URL=

# (opcional) Número de WhatsApp da loja, só dígitos com DDI. Ex.: 5561999999999
# Se definido, aparece o botão "Falar no WhatsApp" no rodapé e na confirmação do formulário.
VITE_WHATSAPP_NUMBER=

# (opcional) URL pública final do site (usada em canonical/OG). Ex.: https://www.seudominio.com.br
VITE_SITE_URL=
